{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake"
        },
        {
            "name": "Debug",
            "displayName": "Debug (-Ofast, release build: plugin host + CYBERYAK label)",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "Stock",
            "displayName": "Stock (Debug without any additions, identical to official firmware)",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "DRUMBOY_PLUGINS": "OFF", "DRUMBOY_BRANDING": "OFF" }
        },
        {
            "name": "Release",
            "displayName": "Release (-Os, smaller, slower DSP)",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "Debug", "configurePreset": "Debug" },
        { "name": "Stock", "configurePreset": "Stock" },
        { "name": "Release", "configurePreset": "Release" }
    ]
}
