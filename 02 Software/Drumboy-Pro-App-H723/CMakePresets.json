{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake"
        },
        {
            "name": "Debug",
            "displayName": "Debug (-Ofast, matches official firmware)",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "Release",
            "displayName": "Release (-Os, smaller, slower DSP)",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "CpuMeter",
            "displayName": "Debug + on-screen CPU meter",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "DRUMBOY_CPU_METER": "ON" }
        },
        {
            "name": "PluginDev",
            "displayName": "Debug + plugin host + CPU meter",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "DRUMBOY_CPU_METER": "ON", "DRUMBOY_PLUGINS": "ON" }
        }
    ],
    "buildPresets": [
        { "name": "Debug", "configurePreset": "Debug" },
        { "name": "Release", "configurePreset": "Release" },
        { "name": "CpuMeter", "configurePreset": "CpuMeter" },
        { "name": "PluginDev", "configurePreset": "PluginDev" }
    ]
}
